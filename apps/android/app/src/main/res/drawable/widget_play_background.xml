<?xml version="1.0" encoding="utf-8"?>
<!-- Accent "glass bead": mostly opaque coral with a light rim and a top highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#E6FF7A59" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
    <item android:bottom="22dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
